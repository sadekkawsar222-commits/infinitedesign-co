      "destination": "/services-mobile-app-development.html"
    },
    {
      "source": "/services/retail-solutions",
      "destination": "/services-retail-solutions.html"
    },
    {
      "source": "/services/saas-development",
      "destination": "/services-saas-development.html"
    },
    {
      "source": "/services/software-development",
