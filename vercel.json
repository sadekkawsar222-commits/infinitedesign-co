    {
      "source": "/work/lumenpay",
      "destination": "/work-lumenpay.html"
    },
    {
      "source": "/work/ostara-bank",
      "destination": "/work-ostara-bank.html"
    },
    {
      "source": "/work/prottasha-health",
      "destination": "/work-prottasha-health.html"
    },
    {
      "source": "/work/rundo-logistics",
